	"info": {
		"_postman_id": "9f7b1e84-482a-4ce2-b2fa-e1df595b1123",
		"name": "Student Management System API - Complete CRUD Collection",
		"description": "Comprehensive Postman test collection for testing all REST API endpoints of the Student Management System college project.\n\nCovers:\n1. Create Student (Valid Data -> 201)\n2. Create Student (Missing Mandatory Data -> 400)\n3. Create Student (Duplicate Email -> 400)\n4. Create Student (Invalid Range / Format -> 400)\n5. Read All Students (List -> 200)\n6. Read All with Search Filter (?search= -> 200)\n7. Read All with Department Filter (?department= -> 200)\n8. Read All with Year Filter (?year= -> 200)\n9. Read Individual Student by ID -> 200\n10. Read Non-existent Student -> 404\n11. Update Student Full (PUT -> 200)\n12. Update Student Partial (PATCH -> 200)\n13. Dashboard Summary Stats -> 200\n14. Delete Student (DELETE -> 200/204)\n15. Delete Non-existent Student -> 404",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
