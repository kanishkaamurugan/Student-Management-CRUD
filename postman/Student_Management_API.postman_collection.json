			"name": "1. Create Student (Valid Data)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 201 Created\", function () {",
							"    pm.response.to.have.status(201);",
							"});",
							"pm.test(\"Response has success flag true\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.success).to.eql(true);",
							"    pm.expect(jsonData.data.name).to.eql(\"Kavya Krishnan\");",
							"    if (jsonData.data && jsonData.data.id) {",
							"        pm.collectionVariables.set(\"created_student_id\", jsonData.data.id);",
							"    }",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"name\": \"Kavya Krishnan\",\n    \"email\": \"kavya.krishnan@college.edu\",\n    \"department\": \"Computer Science\",\n    \"year\": 3,\n    \"cgpa\": 9.25\n}"
				},
